# Beta 4 suite 15: Pomodoro (#107) on the emulator, where the plugin is linked and shipped off, or on an X4 where its
# plugin file is installed and on (alone: --script-file tools/pps/beta4/15-pomodoro.pps).
# The run starts the clock: the first test switches the plugin on (emulator) and the screen runs a
# phase with its buttons. Nothing waits for a minute: the end of a phase is a host test (plugins/pomodoro/tests).
include:common.pps

# On the emulator the plugin ships off: switch it on in Manage plugins, which applies after a restart.
test:pomodoro-01-on {
  if:$target==emu {
    call:home
    call:settings-row:Manage plugins
    until:Plugins:8000
    select:Pomodoro:80
    wait:1500
    expect:Applies after a restart
    restart
    wait:4000
  }
  no-warn
}

# The plugin is a store plugin on the X4: a card without its folder cannot run these (not a failure of the plugin).
define:need-pomodoro {
  if:$target==x4 {
    if:exists:plugins/pomodoro {
      wait:100
    } else {
      skip:the Pomodoro plugin is not installed on this X4 (store plugin, plugins/pomodoro missing)
    }
  }
}

# The screen: a fresh round stands at 25:00 with Start, Skip and Reset; Start runs it, a second Select
# pauses it, Skip goes to the short break (5:00, nothing counted), Reset to the first round.
test:pomodoro-02-screen {
  call:need-pomodoro
  run:pomodoro.open
  until:Pomodoro:8000
  expect:Focus
  expect:25:00
  expect:Start
  expect:Skip
  expect:Reset
  expect-focus:Start
  confirm
  wait:1500
  expect:Pause
  expect-not:Error
  confirm
  wait:1500
  expect:Resume
  right
  wait:500
  expect-focus:Skip
  confirm
  wait:1500
  expect:Short break
  expect:05:00
  expect:Start
  right
  wait:500
  expect-focus:Reset
  confirm
  wait:1500
  expect:Focus
  expect:25:00
  expect-not:Error
  no-warn
}

# The home widgets: the timer shows the phase and the minutes, the day's count its rounds.
test:pomodoro-03-widgets {
  call:need-pomodoro
  set:home.page-1=pomodoro.timer\,pomodoro.today
  call:home
  expect:25 min
  expect:0 rounds today
  expect-not:Error
  set:home.page-1=home.clock\, home.continue\, home.recent
  no-warn
}

test:pomodoro-04-back {
  call:need-pomodoro
  run:pomodoro.open
  until:Pomodoro:8000
  back
  until:Edit:8000
  no-warn
}
