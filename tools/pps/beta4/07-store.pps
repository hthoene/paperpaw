# Beta 4 suite 07: the plugin store's screens. (Installing, switching and removing a plugin over Wi-Fi is the
# X4 run's step 12, ~/dt-jobs/final-b4/steps/12-store.sh: it needs Wi-Fi and restarts.)
include:common.pps

test:07a-store-lists {
  call:home
  page-forward
  select:Plugin store
  until:Popular now:20000
  expect:Search
  expect:New
  expect:Discover
  select:New
  until:Back:15000
  expect-not:Error
  back
  until:Popular now:8000
  back
  until:Edit:10000
  no-warn
}

# The first entry's page opens and Back leaves (the entries of the list change with the catalog; nothing is installed here).
test:07b-store-entry {
  call:home
  page-forward
  select:Plugin store
  until:Popular now:20000
  select:New
  until:By PaperPaw:15000
  right
  confirm
  until:Back:15000
  wait:2000
  expect-not:Error
  back
  wait:1500
  back
  wait:1500
  no-warn
}

# #235: the store without a connection has an empty list; the button hint says what Select does there: "Try again".
# The emulator has a catalog of its own: the check is for the X4 (Wi-Fi off, Plugin store, a list).
test:07c-store-offline-try-again {
  if:$target==emu {
    skip:the emulator's store always has its catalog; offline needs the X4
  }
  call:home
  wifi:off
  wait:500
  page-forward
  select:Plugin store
  until:Back:20000
  select:New
  wait:4000
  # A card that was online once keeps the store's catalog: offline the list is the cached one (Nov 18: "Loading plugins…", then the
  # cached New list). The empty list with "Try again" needs a card without that cache.
  if:shows:Try again {
    expect:Try again
  } else {
    back
    wait:1500
    back
    wait:1500
    skip:the store shows its cached catalog offline (an earlier online visit); the empty-list "Try again" needs a card without the cache
  }
  expect-not:Error
  back
  wait:1500
  back
  wait:1500
  no-warn
}
