# HIL run (tools/pps/hil, #37), limit: Back from a text page to Home draws its first frame within 1.2 s (median of 5).
include:../beta4/common.pps

test:03-back-home {
  call:home
  repeat:5 {
    open:$book
    wait:7000
    measure:back-text:n=1:settle=9000 {
      back
    }
  }
  assert:back-text.first_ms.median<=1200:Back to Home within 1.2 s
}
