# The settings page from the menu, by touch, on the Boox.
profiles: boox-go-7

expect screen home.dashboard
# A tap in the empty middle, below the book card, opens the menu.
tap:632:1008
expect screen menu.list
tap-on:Settings
expect screen settings.list
expect text "Search"
expect no text "Tools"
expect picture settings
back
expect screen home.dashboard
expect no warnings
