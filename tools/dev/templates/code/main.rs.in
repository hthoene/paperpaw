//! @NAME@: a PaperPaw plugin with code, for plugin interface 7.
//!
//! It puts an entry into the tools menu that opens a screen with one line of text. Start
//! from here: `make` says what the plugin brings, `event` is told what happens, `draw` paints
//! the screen and `input` gets its keys and touches.
#![no_std]
#![no_main]

use paperpaw_sdk::{
    Color, Handled,
    native::{
        Error, Host, Plugin,
        callbacks::{DrawFrame, Input},
        commands::CommandSender,
        declare::{ActionDecl, Declarations, MenuEntryDecl, ScreenDecl},
        events::{Event, Incoming, kinds},
        fonts::{Font, FontRole, TextOrigin},
        registrations,
        reply::Reply,
    },
};

/// The numbers the device hands back with what belongs to the screen and to the action.
const SCREEN: u32 = 1;
const OPEN: u32 = 2;

/// The plugin's state: what it keeps between calls. Nothing yet.
struct @TYPE@;

impl Plugin for @TYPE@ {
    /// Called once when the plugin is loaded: declare the screen, the action that opens it and
    /// where the action shows. The ids get the plugin's id in front (`@ID@.screen`); the
    /// titles are keys of `plugin/i18n/<language>.ini`.
    fn make(host: &Host<'_>) -> Result<Self, Error> {
        let mut declarations =
            Declarations::new(|batch| registrations::submit(host, batch).map_err(i32::from));
        let declared = (|| {
            declarations.screen(ScreenDecl::new("screen", "@ID@.title", SCREEN))?;
            declarations.action(ActionDecl::new("open", "@ID@.title", OPEN))?;
            declarations.menu_entry(MenuEntryDecl::new("core.tools", "@ID@.open"))?;
            declarations.submit()
        })();
        declared.map_err(|_| Error::Invalid)?;
        Ok(Self)
    }

    fn event(
        &mut self,
        host: &Host<'_>,
        token: u32,
        incoming: Incoming<'_>,
        _: &mut Reply<'_>,
    ) -> Result<(), Error> {
        if token == OPEN
            && let Some(Event::ActionRun {
                action: "@ID@.open",
                ..
            }) = incoming.decode_as::<kinds::ActionRun>()?
        {
            let mut scratch = [0; 256];
            return CommandSender::new(host, &mut scratch).open_screen("@ID@.screen");
        }
        Ok(())
    }

    fn draw(&mut self, host: &Host<'_>, token: u32, mut frame: DrawFrame<'_>) -> Result<(), Error> {
        if token != SCREEN {
            return Err(Error::Invalid);
        }
        let canvas = frame.draw_canvas()?;
        let area = canvas.frame_rect();
        canvas.fill_rectangle(area, Color::WHITE)?;
        let font = Font::acquire_role(host, FontRole::Ui)?;
        let origin = TextOrigin::new(area.x as f32 + 24.0, area.y + 64);
        font.render_text(&canvas, 24.0, origin, Color::BLACK, "Hello from @NAME@")?;
        font.release()
    }

    fn input(&mut self, _: &Host<'_>, _: u32, _: Input<'_>) -> Result<Handled, Error> {
        // Not handled: the device's own keys (back, home) keep working.
        Ok(Handled::No)
    }
}

// The plugin's entry, its heap and its panic handler. `native/metadata.bin` lists the device's
// functions the plugin calls (`native/metadata.json` is its source); a call that is not listed
// is refused on the device.
paperpaw_sdk::native_plugin!(@TYPE@, metadata = include_bytes!("../native/metadata.bin"));
