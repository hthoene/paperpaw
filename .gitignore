/target/
# Builds into a target directory of their own (CARGO_TARGET_DIR=target-...).
/target-*/
# The X4's firmware builds on its own (see shells/xteink).
/shells/xteink/target/
# Native plugins, built in workspaces of their own.
/samples/hello-native/target/
/crates/paperpaw-core/tests/native-plugin/target/
/tools/plugin-files/target/
**/*.rs.bk

# Emulator output
/out/
# Reading progress and page indexes written by the emulator
/samples/library/.paperpaw/
/samples/library/paperpaw.ini
*.screenshot.png

# Core dumps (a test that aborts on purpose, a crashed process)
core.[0-9]*

# Editors and OS files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Fuzzing (cargo fuzz)
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Claude Code: the skills are shared, the rest stays one's own
/.claude/*
!/.claude/skills/

# Python caches (tools)
__pycache__/
